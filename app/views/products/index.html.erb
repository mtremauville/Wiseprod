<h1>Produits</h1>

<div class="row">
  <% @products.each do |product| %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <%= image_tag product.image_url, class: "card-img-top", alt: product.name, style: "height: 200px; object-fit: cover;" %>
        <div class="card-body">
          <h5 class="card-title"><%= product.name %></h5>
          <p class="card-text"><%= product.category %></p>
          <p class="card-text"><strong><%= product.price %> €</strong></p>
          <%= link_to "Voir le détail", product_path(product), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
