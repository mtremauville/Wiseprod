<%= link_to "← Retour à la liste", products_path, class: "back-link" %>

<nav class="breadcrumb">
  <%= link_to "Produits", products_path %>
  <span>/</span>
  <%= link_to @product.category, products_path(category: @product.category) %>
  <span>/</span>
  <span class="breadcrumb-current"><%= @product.name %></span>
</nav>

<div class="product-detail">
  <div class="product-detail-media">
    <%= image_tag @product.image_url, alt: @product.name %>

    <% if @alternative_products.any? %>
      <div class="alternatives">
        <h4>Alternatives possibles</h4>
        <% @alternative_products.each do |alternative| %>
          <%= link_to product_path(alternative), class: "alternative-card" do %>
            <%= image_tag alternative.image_url, alt: alternative.name %>
            <div>
              <div class="alternative-name"><%= alternative.name %></div>
              <div class="alternative-price"><%= alternative.price %> €</div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if (tip = SalesTip.for(@product.category)) %>
      <div class="sales-tip">
        <svg class="sales-tip-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M9 21h6v-1H9v1zm3-19a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2z" />
        </svg>
        <div>
          <h4>Conseil vendeur</h4>
          <p><%= tip %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="product-detail-info">
    <span class="product-badge"><%= @product.category %></span>
    <h1><%= @product.name %></h1>
    <div class="product-detail-price"><%= @product.price %> €</div>
    <p class="product-detail-description"><%= @product.description %></p>

    <div class="product-detail-panel">
      <h3>Les points forts du <%= @product.name %></h3>
      <ul class="argument-list">
        <% argument_points(@product.sales_argument).each do |point| %>
          <li><%= format_argument_point(point) %></li>
        <% end %>
      </ul>

      <% available_services = FnacService.available_for(@product.category) %>
      <% if available_services.any? %>
        <h3 style="margin-top: 24px;">Services Fnac recommandés</h3>
        <ul class="service-list">
          <% available_services.each do |service| %>
            <li><%= service[:name] %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</div>
