<%= image_tag @product.image_url, class: "img-fluid mb-3", alt: @product.name, style: "max-height: 300px;" %>
<h1><%= @product.name %></h1>
<p><strong>Catégorie :</strong> <%= @product.category %></p>
<p><strong>Prix :</strong> <%= @product.price %> €</p>
<p><strong>Description :</strong> <%= @product.description %></p>
<p><strong>Argument de vente :</strong> <%= @product.sales_argument %></p>

<%= link_to "← Retour à la liste", products_path %>

<hr>
<h3>Générer un argumentaire de vente</h3>

<%= form_with url: generate_sales_argument_product_path(@product), method: :post do |f| %>
  <% available_services = FnacService.available_for(@product.category) %>

  <% if available_services.any? %>
    <div class="mb-3">
      <p><strong>Services additionnels à proposer :</strong></p>
      <% available_services.each do |key, service| %>
        <div class="form-check">
          <input type="checkbox" name="services[]" value="<%= key %>" class="form-check-input" id="service_<%= key %>">
          <label class="form-check-label" for="service_<%= key %>"><%= service[:name] %></label>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">Aucun service additionnel disponible pour cette catégorie.</p>
  <% end %>

  <%= f.submit "Générer l'argumentaire", class: "btn btn-success" %>
<% end %>

<% if flash[:sales_argument].present? %>
  <h4 class="mt-4">Argumentaire généré</h4>
  <div class="card mb-2">
    <div class="card-body">
      <% if flash[:sales_argument_services].present? %>
        <p><em>Services proposés : <%= FnacService.names_for(flash[:sales_argument_services].split(",")).join(", ") %></em></p>
      <% end %>
      <p><%= simple_format(flash[:sales_argument]) %></p>
    </div>
  </div>
<% end %>
