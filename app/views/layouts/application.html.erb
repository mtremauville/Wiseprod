<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wiseprod" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wiseprod">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "wiseprod" %>
    <%= javascript_importmap_tags %>
  </head>

 <body class="<%= "has-full-bleed" if devise_controller? %>" data-controller="page-loader"
      data-action="turbo:before-visit@document->page-loader#show turbo:load@document->page-loader#hide">
  <div class="page-loader" data-page-loader-target="overlay">
    <svg class="page-loader-spinner" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8A5.87 5.87 0 0 1 6 12c0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z" />
    </svg>
    <p>Chargement…</p>
  </div>
  <nav class="navbar-wiseprod">
    <%= link_to "WiseProd", root_path, class: "navbar-brand" %>
    <div class="navbar-account">
      <% if user_signed_in? %>
        <span>Conseiller : <%= current_user.email %></span>
      <div data-controller="modal">
        <button data-action="modal#open" class="link-logout">Se déconnecter</button>

        <dialog data-modal-target="dialog" data-action="click->modal#closeOnBackdrop" class="confirm-modal">
          <h3>Se déconnecter ?</h3>
          <p>Tu devras te reconnecter pour accéder à WiseProd.</p>
          <div class="confirm-modal-actions">
            <button data-action="modal#close" class="btn-secondary">Annuler</button>
            <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "btn-generate" %>
          </div>
        </dialog>
      </div>
      <% end %>
    </div>
  </nav>
  <% unless devise_controller? %>
    <% if flash[:notice].present? %>
      <div class="page-flash auth-flash-notice" data-controller="toast"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="page-flash auth-flash-alert" data-controller="toast"><%= flash[:alert] %></div>
    <% end %>
  <% end %>

  <main class="page-main">
    <%= yield %>
  </main>
  <%= render "shared/footer" %>

</body>
</html>
