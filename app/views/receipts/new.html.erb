<% content_for :title, "Finaliser le ticket de caisse · WiseProd" %>

<%= link_to "← Retour au panier", cart_path, class: "back-link" %>

<h1>Finaliser le ticket de caisse</h1>

<% if @cart_customer %>
  <div class="cart-customer">
    <div class="cart-customer-assigned">
      <div class="cart-customer-info">
        <span class="cart-customer-label">Client assigné au panier</span>
        <p class="cart-customer-name">
          <%= @cart_customer.full_name %>
          <span class="matricule-badge"><%= @cart_customer.matricule %></span>
        </p>
        <p class="cart-customer-contact"><%= @cart_customer.email %> · <%= @cart_customer.phone %></p>
      </div>
      <%= button_to "Confirmer et finaliser", receipts_path(customer_id: @cart_customer.id), method: :post, class: "btn-generate" %>
    </div>
    <p class="cart-checkout-hint">Ce n'est pas le bon client ? Recherchez-en un autre ci-dessous.</p>
  </div>
<% end %>

<%= form_with url: new_receipt_path, method: :get, class: "filter-bar" do %>
  <%= search_field_tag :q, @customer_search, placeholder: "Rechercher un client (téléphone, email)…", class: "filter-search", autocomplete: "off" %>
  <button type="submit" class="filter-submit">Rechercher</button>
<% end %>

<% if @customer_search.present? %>
  <% if @customers.any? %>
    <div class="customer-grid">
      <% @customers.each do |customer| %>
        <div class="customer-card">
          <div class="customer-card-header">
            <span class="customer-card-name"><%= customer.full_name %></span>
            <span class="matricule-badge"><%= customer.matricule %></span>
          </div>
          <p class="customer-card-contact"><%= customer.email %></p>
          <p class="customer-card-contact"><%= customer.phone %></p>
          <%= button_to "Sélectionner ce client", receipts_path(customer_id: customer.id), method: :post, class: "btn-generate customer-card-cta" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>Aucun client ne correspond à « <%= @customer_search %> ».</p>
      <%= link_to "+ Créer ce client", new_customer_path, class: "btn-secondary" %>
    </div>
  <% end %>
<% end %>
