<div class="questionnaire-step">
  <div class="step-progress">Étape 1</div>
  <h1>Quel type d'appareil le client cherche-t-il ?</h1>

  <%= form_with url: device_type_consultations_path, method: :post, class: "tile-grid" do |f| %>
    <button type="submit" name="device_type" value="ordinateur" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="12" rx="1" />
        <path d="M2 19h20l-1.5-3h-17z" />
      </svg>
      Ordinateur portable
    </button>

    <button type="submit" name="device_type" value="tablette" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="5" y="2" width="14" height="20" rx="2" />
        <line x1="12" y1="18" x2="12" y2="18.01" />
      </svg>
      Tablette
    </button>

    <button type="submit" name="device_type" value="smartphone" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="7" y="2" width="10" height="20" rx="2" />
        <line x1="12" y1="18" x2="12" y2="18.01" />
      </svg>
      Smartphone
    </button>

    <button type="submit" name="device_type" value="je_ne_sais_pas" class="tile-option tile-option-unsure">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="9" />
        <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5" />
        <line x1="12" y1="16.5" x2="12" y2="16.51" />
      </svg>
      Je ne sais pas — aidez-moi à choisir
    </button>
  <% end %>
</div>
