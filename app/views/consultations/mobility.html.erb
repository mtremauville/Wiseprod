<div class="questionnaire-step">
  <%= render "step_progress" %>
  <h1>Quel format lui conviendrait le mieux ?</h1>

  <%= form_with url: mobility_consultations_path, method: :post, class: "tile-grid" do |f| %>
    <button type="submit" name="mobility" value="ordinateur" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="12" rx="1" />
        <path d="M2 19h20l-1.5-3h-17z" />
      </svg>
      Poste de travail complet
    </button>

    <button type="submit" name="mobility" value="tablette" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="5" y="2" width="14" height="20" rx="2" />
        <line x1="12" y1="18" x2="12" y2="18.01" />
      </svg>
      Léger et transportable
    </button>

    <button type="submit" name="mobility" value="smartphone" class="tile-option">
      <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="7" y="2" width="10" height="20" rx="2" />
        <line x1="12" y1="18" x2="12" y2="18.01" />
      </svg>
      Toujours sur lui
    </button>

  <% end %>
</div>
