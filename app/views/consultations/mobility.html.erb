<div class="questionnaire-step">
  <div class="step-progress">Étape 4 sur 5</div>
  <h1>Quel format lui conviendrait le mieux ?</h1>

  <%= form_with url: mobility_consultations_path, method: :post, class: "tile-grid" do |f| %>
    <% [["ordinateur", "Poste de travail complet"], ["tablette", "Léger et transportable"], ["smartphone", "Toujours sur lui"]].each do |value, label| %>
      <button type="submit" name="mobility" value="<%= value %>" class="tile-option"><%= label %></button>
    <% end %>
  <% end %>
</div>
